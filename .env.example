# Copy to .env and fill in:  cp .env.example .env
# This file is the committed template and must never contain a real key.
# `.env` itself is gitignored — never commit it.

# --- Database (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets

# For running the backend outside Docker (docker-compose overrides this to host "db")
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tickets

# --- LLM (any OpenAI-compatible API; Groq by default) ---
# Free key: https://console.groq.com/keys — leave empty to run without AI
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=10

# --- API ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Frontend ---
# NEXT_PUBLIC_* values are inlined into the browser bundle at image build time
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000